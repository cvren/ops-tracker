generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  NEEDS_REVIEW
  CHANGES_REQUESTED
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecurringCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum BlockedCategory {
  DEPENDENCY
  EXTERNAL
  DECISION
  CAPACITY
  OTHER
}

enum ActivityEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_BULK_UPDATED
  TASK_ASSIGNEE_CHANGED
  TASK_REVIEWER_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_STATUS_CHANGED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_REVIEW_REQUESTED
  TASK_REVIEW_APPROVED
  TASK_CHANGES_REQUESTED
  TASK_CREATED_FROM_TEMPLATE
  TASK_TEMPLATE_CREATED
  TASK_TEMPLATE_UPDATED
  RECURRING_SCHEDULE_CREATED
  RECURRING_SCHEDULE_UPDATED
  RECURRING_SCHEDULE_EXECUTED
  COMMENT_CREATED
  COMMENT_MENTIONED
  MEMBERSHIP_ADDED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  passwordHash          String
  role                  String          @default("member")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sessions              Session[]
  memberships           Membership[]
  addedMemberships      Membership[]    @relation("MembershipAddedBy")
  ownedProjects         Project[]       @relation("ProjectOwner")
  updatedProjects       Project[]       @relation("ProjectUpdater")
  assignedTasks         Task[]          @relation("TaskAssignee")
  reviewTasks           Task[]          @relation("TaskReviewer")
  createdTasks          Task[]          @relation("TaskCreator")
  updatedTasks          Task[]          @relation("TaskUpdater")
  reviewRequestedTasks  Task[]          @relation("TaskReviewRequester")
  reviewedTasks         Task[]          @relation("TaskReviewedBy")
  createdTaskTemplates  TaskTemplate[]  @relation("TaskTemplateCreatedBy")
  updatedTaskTemplates  TaskTemplate[]  @relation("TaskTemplateUpdatedBy")
  createdRecurringSchedules RecurringSchedule[] @relation("RecurringScheduleCreatedBy")
  updatedRecurringSchedules RecurringSchedule[] @relation("RecurringScheduleUpdatedBy")
  defaultAssigneeTemplates TaskTemplate[] @relation("TaskTemplateDefaultAssignee")
  defaultReviewerTemplates TaskTemplate[] @relation("TaskTemplateDefaultReviewer")
  comments              Comment[]       @relation("CommentAuthor")
  mentionedComments     CommentMention[]
  activityEvents        ActivityEvent[] @relation("ActivityActor")
  notifications         Notification[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  projects       Project[]
  taskTemplates  TaskTemplate[]
  recurringSchedules RecurringSchedule[]
  activityEvents ActivityEvent[]
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  addedById   String?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy     User?         @relation("MembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model Project {
  id             String          @id @default(cuid())
  workspaceId     String
  name            String
  code            String          @unique
  description     String
  status          ProjectStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ownerId         String
  updatedById     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  updatedBy       User            @relation("ProjectUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  tasks           Task[]
  recurringSchedules RecurringSchedule[]
  activityEvents  ActivityEvent[]

  @@index([workspaceId, status, name])
}

model TaskTemplate {
  id                   String       @id @default(cuid())
  workspaceId          String
  name                 String
  title                String
  description          String
  defaultAssigneeId    String?
  defaultReviewerId    String?
  defaultDueOffsetDays Int?
  defaultPriority      TaskPriority @default(MEDIUM)
  defaultStatus        TaskStatus   @default(BACKLOG)
  createdById          String
  updatedById          String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultAssignee      User?        @relation("TaskTemplateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  defaultReviewer      User?        @relation("TaskTemplateDefaultReviewer", fields: [defaultReviewerId], references: [id], onDelete: SetNull)
  createdBy            User         @relation("TaskTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User         @relation("TaskTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  recurringSchedules   RecurringSchedule[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model RecurringSchedule {
  id         String            @id @default(cuid())
  templateId String
  workspaceId String
  projectId  String
  cadence    RecurringCadence
  interval   Int               @default(1)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  isActive   Boolean           @default(true)
  createdById String
  updatedById String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  template   TaskTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("RecurringScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User              @relation("RecurringScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  executions RecurringExecution[]

  @@index([workspaceId, isActive, nextRunAt])
  @@index([projectId, isActive])
}

model RecurringExecution {
  id            String            @id @default(cuid())
  scheduleId    String
  scheduledFor  DateTime
  executedAt    DateTime          @default(now())
  createdTaskId String?
  schedule      RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdTask   Task?             @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledFor])
  @@index([executedAt])
}

model Task {
  id                  String           @id @default(cuid())
  title               String
  description         String
  status              TaskStatus       @default(BACKLOG)
  priority            TaskPriority     @default(MEDIUM)
  dueDate             DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  blockedReason       String?
  blockedCategory     BlockedCategory?
  reviewRequestedAt   DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  projectId           String
  assigneeId          String?
  reviewerId          String?
  createdById         String
  updatedById         String
  reviewRequestedById String?
  reviewedById        String?
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee            User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer            User?            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy           User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User             @relation("TaskUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  reviewRequestedBy   User?            @relation("TaskReviewRequester", fields: [reviewRequestedById], references: [id], onDelete: SetNull)
  reviewedBy          User?            @relation("TaskReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  comments            Comment[]
  activityEvents      ActivityEvent[]
  recurringExecutions RecurringExecution[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([reviewerId, status])
  @@index([dueDate, status])
  @@index([title])
}

model Comment {
  id             String          @id @default(cuid())
  body           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  taskId         String
  authorId       String
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentions       CommentMention[]
  activityEvents ActivityEvent[]

  @@index([taskId, createdAt])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model ActivityEvent {
  id             String            @id @default(cuid())
  workspaceId     String
  projectId       String?
  taskId          String?
  commentId       String?
  actorId         String?
  type            ActivityEventType
  payload         Json?
  createdAt       DateTime          @default(now())
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment         Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor           User?             @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model Notification {
  id              String        @id @default(cuid())
  userId          String
  activityEventId String
  createdAt       DateTime      @default(now())
  readAt          DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityEvent   ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)

  @@unique([userId, activityEventId])
  @@index([userId, readAt, createdAt])
}
